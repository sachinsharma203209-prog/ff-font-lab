# Public env vars (safe to expose client-side). Copy to .env for local overrides.
# Empty/missing = feature stays disabled; site works fully without them.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
PUBLIC_ADSENSE_CLIENT=
