---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import AdSlot from '../../components/AdSlot.astro';
import FontGenerator from '../../components/FontGenerator.astro';
import { PLATFORM_COMPATIBILITY } from '../../data/platforms';
import { getRelatedContent } from '../../lib/related';
import { generateWebPageSchema } from '../../lib/schema';

export function getStaticPaths() {
  return PLATFORM_COMPATIBILITY.map((p) => ({
    params: { platform: p.slug },
    props: { p },
  }));
}

const { p } = Astro.props;
const canonical = `/compatibility/${p.slug}`;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Compatibility", href: "/compatibility" },
  { label: p.name, href: canonical },
];

const related = getRelatedContent(`platform:${p.id}`, 6);

const supportMeta: Record<string, { icon: string; color: string; bg: string }> = {
  yes: { icon: "check_circle", color: "text-green-400", bg: "bg-green-400/10" },
  partial: { icon: "error", color: "text-yellow-400", bg: "bg-yellow-400/10" },
  no: { icon: "cancel", color: "text-red-400", bg: "bg-red-400/10" },
};

const pageSchema = generateWebPageSchema({
  title: `${p.seoTitle} | Ff Font Lab`,
  description: p.seoDescription,
  url: `https://fontchange.co.in${canonical}`,
  breadcrumbs: breadcrumbs.map((b) => ({ name: b.label, url: `https://fontchange.co.in${b.href}` })),
});
---

<BaseLayout
  title={`${p.seoTitle} | Ff Font Lab`}
  description={p.seoDescription}
  canonical={canonical}
  jsonLd={pageSchema}
  activePage="home"
>
  <div class="flex flex-col gap-6">
    <Breadcrumb items={breadcrumbs} />

    <div class="flex flex-col gap-3">
      <h1 class="text-[28px] md:text-[36px] font-bold text-on-surface leading-tight" style="font-family: Sora;">
        {p.name} Font Compatibility
      </h1>
      <p class="text-[15px] text-on-surface-variant leading-relaxed max-w-[720px]" style="font-family: Inter;">
        {p.intro}
      </p>
    </div>

    <div class={`surface-card rounded-lg p-4 flex items-start gap-3 ${""}`}>
      <span class="material-symbols-outlined text-[20px] text-primary flex-shrink-0" aria-hidden="true">info</span>
      <p class="text-[14px] text-on-surface-variant leading-relaxed" style="font-family: Inter;">
        <strong class="text-on-surface">Short answer:</strong> {p.canUseFancyText}
      </p>
    </div>

    <FontGenerator
      styles={p.stylesThatWork.map((s) => s.styleId)}
      placeholder={`Type text for ${p.name}...`}
      defaultText=""
    />

    <AdSlot slot={`compatibility-${p.slug}-below`} format="horizontal" />

    <section class="flex flex-col gap-4">
      <h2 class="text-[22px] font-bold text-on-surface" style="font-family: Sora;">
        Where you can paste styled text
      </h2>
      <div class="surface-card rounded-lg overflow-hidden">
        {
          p.whereToPaste.map((row, i) => {
            const meta = supportMeta[row.support];
            return (
              <div class={`flex items-start gap-3 p-4 ${i > 0 ? "border-t border-outline-variant" : ""}`}>
                <span class={`material-symbols-outlined text-[18px] ${meta.color} flex-shrink-0 mt-0.5`} aria-hidden="true">{meta.icon}</span>
                <div class="flex flex-col gap-0.5 min-w-0">
                  <span class="text-[14px] font-semibold text-on-surface" style="font-family: Inter;">{row.field}</span>
                  <span class="text-[13px] text-on-surface-variant" style="font-family: Inter;">{row.note}</span>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-[22px] font-bold text-on-surface" style="font-family: Sora;">
        Styles that render well on {p.name}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          p.stylesThatWork.map((s) => (
            <div class="surface-card rounded-lg p-4 flex flex-col gap-1.5">
              <span class="text-[14px] font-semibold text-primary" style="font-family: JetBrains Mono;">{s.style}</span>
              <span class="text-[13px] text-on-surface-variant leading-relaxed" style="font-family: Inter;">{s.note}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-[22px] font-bold text-on-surface" style="font-family: Sora;">
        Honest limitations
      </h2>
      <ul class="surface-card rounded-lg p-5 flex flex-col gap-2.5 list-none m-0">
        {
          p.limitations.map((lim) => (
            <li class="text-[14px] text-on-surface-variant leading-relaxed flex items-start gap-2" style="font-family: Inter;">
              <span class="material-symbols-outlined text-[16px] text-on-surface-variant mt-0.5 flex-shrink-0" aria-hidden="true">remove</span>
              {lim}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-[22px] font-bold text-on-surface" style="font-family: Sora;">
        Troubleshooting
      </h2>
      <div class="flex flex-col gap-3">
        {
          p.troubleshooting.map((t) => (
            <div class="surface-card rounded-lg p-4 flex flex-col gap-1.5">
              <span class="text-[14px] font-semibold text-on-surface flex items-center gap-2" style="font-family: Inter;">
                <span class="material-symbols-outlined text-[16px] text-yellow-400" aria-hidden="true">help</span>
                {t.problem}
              </span>
              <span class="text-[13px] text-on-surface-variant leading-relaxed pl-6" style="font-family: Inter;">{t.solution}</span>
            </div>
          ))
        }
      </div>
    </section>

    <FAQ faqs={p.faqs} />

    {
      p.relatedGenerators.length > 0 && (
        <section class="flex flex-col gap-3">
          <h2 class="text-[22px] font-bold text-on-surface" style="font-family: Sora;">
            Generators tuned for {p.name}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {p.relatedGenerators.map((gen) => (
              <a href={gen.href} class="surface-card rounded-lg p-4 flex items-center gap-3 group">
                <span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">arrow_outward</span>
                <span class="text-[14px] font-medium text-on-surface group-hover:text-primary transition-colors" style="font-family: Inter;">
                  {gen.title}
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <RelatedContent items={related} title="Keep exploring" />
  </div>
</BaseLayout>
