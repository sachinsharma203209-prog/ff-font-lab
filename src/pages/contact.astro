---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../lib/site-config';
import { generateWebPageSchema } from '../lib/schema';
const title = 'Contact Us | Ff Font Lab';
const description = 'Contact Ff Font Lab with questions, feedback, bug reports, partnership inquiries, or privacy requests.';
const canonical = '/contact';
const jsonLd = generateWebPageSchema({ title, description, url: `${SITE_CONFIG.url}${canonical}` });
const channels = [
  { icon: 'tag', name: 'Twitter / X', value: '@ffontlab', href: 'https://twitter.com/ffontlab' },
  { icon: 'photo_camera', name: 'Instagram', value: '@ffontlab', href: 'https://instagram.com/ffontlab' },
  { icon: 'play_circle', name: 'YouTube', value: '@ffontlab', href: 'https://youtube.com/@ffontlab' },
];
---
<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} activePage="contact">
  <article class="max-w-[800px] flex flex-col gap-8">
    <header class="flex flex-col gap-3"><p class="text-[12px] font-mono font-bold uppercase tracking-wider text-primary">Support</p><h1 class="text-[30px] md:text-[40px] font-bold text-on-surface font-display">Contact Us</h1><p class="text-[15px] text-on-surface-variant leading-7 max-w-[680px]">Questions, feedback, bug reports, business inquiries, and privacy requests are welcome. Message us through any official channel below.</p></header>
    <div class="grid sm:grid-cols-3 gap-4">
      {channels.map((channel) => <a href={channel.href} target="_blank" rel="noopener noreferrer" class="surface-card group flex flex-col gap-4"><span class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center"><span class="material-symbols-outlined text-[22px] text-primary">{channel.icon}</span></span><span><strong class="block text-[15px] text-on-surface font-display">{channel.name}</strong><span class="text-[14px] text-primary group-hover:underline font-body">{channel.value}</span></span></a>)}
    </div>
    <section class="surface-card flex flex-col gap-3"><h2 class="text-[21px] font-bold text-on-surface font-display">How we can help</h2><p class="text-[15px] text-on-surface-variant leading-7 font-body">For faster help, include the page URL, the device and browser you use, and a short description of the issue. Please do not send passwords, payment details, or other sensitive information. We aim to review genuine messages as promptly as possible.</p></section>
  </article>
</BaseLayout>
