---
interface Props {
  title?: string;
  message?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "More styles on the way",
  message = "We're expanding the lab with new Unicode packs, effects and platform-specific presets — all free, no sign-up.",
  ctaLabel = "Explore all tools",
  ctaHref = "/tools",
} = Astro.props;
---

<section class="surface-card rounded-xl p-6 md:p-8 relative overflow-hidden" aria-label="Preview of upcoming features">
  <div class="absolute inset-0 pointer-events-none opacity-40" aria-hidden="true">
    <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-10 w-52 h-52 rounded-full bg-secondary/10 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
    <div class="flex flex-col gap-1.5 flex-1 min-w-0">
      <h2 class="text-[18px] md:text-[20px] font-bold text-on-surface" style="font-family: Sora;">
        {title}
      </h2>
      <p class="text-[14px] text-on-surface-variant leading-relaxed" style="font-family: Inter;">
        {message}
      </p>
    </div>
    <a
      href={ctaHref}
      class="btn-primary text-[14px] px-5 py-2.5 whitespace-nowrap self-start md:self-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"
    >
      {ctaLabel}
      <span class="material-symbols-outlined text-[16px]" aria-hidden="true">arrow_forward</span>
    </a>
  </div>
</section>
