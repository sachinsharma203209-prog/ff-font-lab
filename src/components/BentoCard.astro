---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
}

const { title, description, href, icon } = Astro.props;
---

<a href={href} class="surface-card rounded-lg p-5 flex flex-col gap-3 group block">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
      <span class="material-symbols-outlined text-[22px] text-primary">{icon}</span>
    </div>
    <h3 class="text-[16px] font-semibold text-on-surface group-hover:text-primary transition-colors" style="font-family: Sora;">
      {title}
    </h3>
  </div>
  <p class="text-[14px] text-on-surface-variant leading-relaxed" style="font-family: Inter;">
    {description}
  </p>
  <span class="text-[13px] text-primary font-medium flex items-center gap-1 mt-auto" style="font-family: Inter;">
    Explore
    <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
  </span>
</a>
